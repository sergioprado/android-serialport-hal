cc_binary {
    name: "vendor.labworks.serialport-service",
    srcs: [
        "SerialPort.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.labworks.serialport-V1-ndk",
    ],
    init_rc: ["vendor.labworks.serialport-service.rc"],
    vintf_fragments: ["manifest_serialport.xml"],
    vendor: true,
    relative_install_path: "hw",
}

vintf_compatibility_matrix {
    name: "compatibility_matrix_serialport.xml",
    srcs: ["compatibility_matrix_serialport.xml"],
    system_ext_specific: true,
}
